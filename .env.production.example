# Production environment. Copy to .env.production on the server and fill in.
# Never commit the filled-in file — .env* is already gitignored.

# --- Required to deploy -----------------------------------------------------
# Hostname Caddy issues a TLS certificate for. Before the client's DNS is
# delegated, use <server-ip>.sslip.io (e.g. 203-0-113-10.sslip.io) — it resolves
# to the IP automatically and gets a real certificate.
SITE_HOST=
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_USER=oye
POSTGRES_DB=oyecouture

# --- Product images ---------------------------------------------------------
# Origin-relative default serves images bundled with the storefront. Point this
# at the Cloudflare R2 public bucket URL to serve from R2 with no code change.
R2_PUBLIC_BASE=/images/catalogue

# --- Payments (pending client credentials) ----------------------------------
PAYMENT_PROVIDER=nomba
NOMBA_ENV=sandbox
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
NOMBA_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# --- Email (pending client credentials) -------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Oyecouture <orders@example.com>"
OWNER_NOTIFY_EMAIL=

# --- WhatsApp ---------------------------------------------------------------
# International format, no plus sign, e.g. 2348012345678
WHATSAPP_NUMBER=
